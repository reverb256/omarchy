#!/bin/bash

# omarchy:summary=Update the active Omarchy dev checkout

set -euo pipefail

[[ $OMARCHY_PATH != "/usr/share/omarchy" ]] || exit 0

if ! git -C "$OMARCHY_PATH" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Error: OMARCHY_PATH is not a git checkout: $OMARCHY_PATH" >&2
  exit 1
fi

upstream=$(git -C "$OMARCHY_PATH" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)
if [[ -z $upstream ]]; then
  echo -e "\e[33m\nSkip Omarchy dev checkout update (current branch has no upstream)\e[0m"
  exit 0
fi

echo -e "\e[32m\nUpdate Omarchy dev checkout\e[0m"

# Bundled agent skills are symlinked into ~/.hermes/skills/ (and the
# equivalent dirs for Claude, Codex, Gemini, etc.). When an agent
# edits one, the change writes through the symlink into this git
# checkout, leaving the working tree dirty. A plain `git pull --ff-only`
# aborts on uncommitted changes — and with pull.rebase=true in a user's
# git config, it tries to rebase even with --ff-only, which also needs a
# clean tree.
#
# Stash, pull, restore — only when the tree is dirty, so the update
# never stalls on agent edits or stray local changes.

if git -C "$OMARCHY_PATH" diff --quiet; then
  git -C "$OMARCHY_PATH" pull --ff-only --no-rebase
else
  git -C "$OMARCHY_PATH" stash push -u -m "omarchy update"
  git -C "$OMARCHY_PATH" pull --ff-only --no-rebase
  git -C "$OMARCHY_PATH" stash pop
fi
